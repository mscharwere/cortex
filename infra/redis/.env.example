# Shared Redis — environment variable template
#
# Copy to /volume1/docker/redis/.env on the Synology NAS.
# This file is committed; the real .env is gitignored.
#
# IMPORTANT: REDIS_PASSWORD here must exactly match REDIS_PASSWORD in every
# consuming app's .env (e.g. /volume1/docker/cortex/.env).
#
# Generate with: openssl rand -hex 32

REDIS_PASSWORD=__GENERATE__
