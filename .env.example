# CORTEX — environment variable template
#
# Copy this file to .env and fill in real values before deploying.
# .env is gitignored.  This file is committed as a reference.
#
# Deploy path: copy .env + docker/docker-compose.yml to
#   /volume1/docker/cortex/ on the Synology NAS, then `docker compose up -d`.
#
# Spec: C:/Jarvis/Team/TARS/cortex_architecture.md v3.1 §4.

# ── MariaDB (shared external instance on Synology NAS) ────────────────────────
# The family-app suite shares one MariaDB at 192.168.30.4:3306.
# CORTEX gets its own database + user (created by scripts/bootstrap.sql).
# Generate passwords with: openssl rand -hex 32
DB_HOST=192.168.30.4
DB_PORT=3306
DB_NAME=cortex
DB_USER=cortex
DB_PASS=__GENERATE__

# ── Redis (shared external instance on Synology NAS) ──────────────────────────
# Shared Redis for the family-app suite — see infra/redis/ for the compose.
# CORTEX uses logical DB 2 (see infra/redis/README.md for the per-app DB map).
# REDIS_PASSWORD must match the value in infra/redis/.env.
# Generate with: openssl rand -hex 32
REDIS_HOST=192.168.30.4
REDIS_PORT=6379
REDIS_PASSWORD=__GENERATE__
REDIS_DB=2

# ── LiteLLM (MS-S1 MAX inference proxy) ───────────────────────────────────────
# Canonical hostname: ollama.perwnet.com (per reference_ollama_perwnet_hostname.md)
# Port 4000 = LiteLLM proxy (OpenAI-compatible /v1/chat/completions)
LITELLM_BASE_URL=http://ollama.perwnet.com:4000
LITELLM_API_KEY=__GENERATE__

# ── CORTEX internal ────────────────────────────────────────────────────────────
# HMAC / internal service auth (§7 REST auth gate).
# Generate with: openssl rand -hex 32
CORTEX_SECRET_KEY=__GENERATE__
CORTEX_ENV=production

# ── HomeOps integration ────────────────────────────────────────────────────────
HOMEOPS_BASE_URL=http://192.168.30.4:4000
CORTEX_API_KEY=__GENERATE__   # must match CORTEX_API_KEY in HomeOps .env

# ── Home Assistant ─────────────────────────────────────────────────────────────
HOMEASSISTANT_URL=https://homeassistant.perwnet.com:8123
HOMEASSISTANT_TOKEN=__GENERATE__   # long-lived HA token (Settings → Profile → Long-Lived Access Tokens)

# ── VacuumOps module ───────────────────────────────────────────────────────────
CORTEX_VACUUMOPS_DRY_RUN=true   # set to false after 2-week observation window

# Mop-cadence gate master switch (modules/vacuumops/mop.py) — NOT an env var
# as of 2026-08-18. It is now a live, DB-backed setting so Carlos has a fast
# kill switch (toggle in the HomeOps UI, no redeploy) instead of SSH + .env +
# docker compose up -d. Managed via HomeOps: GET/PATCH
# /api/cortex/vacuumops-settings (cortex_vacuumops_settings table, defaults
# false — opt-in, since wet-mopping runs unsupervised). CORTEX reads it fresh
# every loop tick and fails closed to "do not mop" on any read problem
# (HomeOps unreachable, malformed response, missing field). No action needed
# here — nothing to set.

# ── Service behaviour ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
CORTEX_PORT=8000

# ── Notes ─────────────────────────────────────────────────────────────────────
# DATABASE_URL and REDIS_URL are assembled from the above component vars inside
# docker-compose.yml (environment: block) — do NOT set them here to avoid
# duplication / drift.  Settings.py reads DATABASE_URL and REDIS_URL from the
# container environment.
#
# Removed from PR #3 (were bundled-mariadb-only vars, now unused):
#   MARIADB_ROOT_PASSWORD, MARIADB_DATABASE, MARIADB_USER, MARIADB_PASSWORD
